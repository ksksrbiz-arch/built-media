# ============================================
# Built Media — Environment Variables
# ============================================

# --- Supabase (REQUIRED) ---
# Get from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGc...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# --- Stripe (REQUIRED for billing) ---
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe price IDs (created by `npm run stripe:setup`)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_STUDIO=price_...

# --- Clip Engines ---
# Active engine: "opus" | "mock". Defaults to "mock" if unset (returns fake clips for dev).
CLIP_ENGINE=mock

# Opus Clip — leave blank to use mock engine
OPUS_API_KEY=
OPUS_WEBHOOK_SECRET=

# --- App ---
# Local dev: use http://localhost:8888
# Production: set to https://clips.1commerce.online (or your subdomain)
VITE_APP_URL=http://localhost:8888
APP_URL=http://localhost:8888

# --- Service-to-service auth (OPTIONAL) ---
# Lets a trusted first-party backend (e.g. the UnifyOne app) submit and read
# clip jobs without an end-user Supabase JWT. The caller sends the shared key
# in the `x-built-media-key` header; matching requests act on behalf of the
# service user below and SKIP built-media's own quota/subscription gate
# (the upstream platform is expected to meter usage itself).
#
# BUILT_MEDIA_SERVICE_USER_ID must be a real Supabase auth.users id — clip and
# usage_event rows reference auth.users(id), so provision a dedicated service
# account in Supabase Auth and paste its UUID here.
BUILT_MEDIA_API_KEY=
BUILT_MEDIA_SERVICE_USER_ID=
